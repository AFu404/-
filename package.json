{
  "name": "basketball-vote",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "check": "npm run check -w server && npm run build -w web",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wrangler": "^4.118.0"
  }
}
